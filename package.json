{
  "name": "icloud-mail",
  "description": "View your iCloud mail in a native Windows application.",
  "author": {
    "name": "Taylor Ivanoff"
  },
  "version": "1.0.33",
  "repository": "https://github.com/taylorivanoff/icloud-mail-windows",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "bump": "node scripts/bump-version.js",
    "release": "node scripts/minify-release.cjs && electron-builder --project .release-staging --win --x64 --publish=never",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "minify:release": "node scripts/minify-release.cjs"
  },
  "build": {
    "appId": "io.github.taylorivanoff.icloud-mail",
    "productName": "iCloud Mail",
    "win": {
      "icon": "icon.png",
      "target": "nsis",
      "artifactName": "${name}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "installer.nsh",
      "deleteAppDataOnUninstall": true
    },
    "publish": {
      "provider": "generic",
      "url": "https://github.com/taylorivanoff/icloud-mail-windows/releases/latest/download"
    },
    "protocols": {
      "name": "iCloud Mail",
      "schemes": [
        "icloud-mail"
      ]
    },
    "compression": "maximum"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "icloud-windows-base": "github:taylorivanoff/icloud-windows-base"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-reloader": "^1.2.3",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "globals": "^16.0.0"
  }
}
